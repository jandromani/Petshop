    "@vercel/queue": "^0.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "@workflow/core": "5.2.2",
    "@workflow/next": "5.0.5",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",

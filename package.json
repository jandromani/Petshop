{
  "name": "atlas-living-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:e2e": "playwright test",
    "directory:import": "node scripts/import-directory.mjs",
    "maplibre:assets": "node scripts/copy-maplibre-assets.mjs",
    "predev": "npm run maplibre:assets",
    "prebuild": "npm run maplibre:assets",
    "prevercel-build": "npm run maplibre:assets"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@vercel/analytics": "^2.0.1",

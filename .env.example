# AI runtime routing. "openrouter" prefers the low-cost/free OpenRouter lane and keeps Vercel AI Gateway as fallback.
AGENT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_PUBLIC_MODEL=openrouter/free
OPENROUTER_ACTOR_MODEL=minimax/minimax-m3:free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
AGENT_ALLOW_PAID_FALLBACK=false

# Optional Vercel AI Gateway fallback; OIDC is injected automatically on Vercel.
AI_GATEWAY_MODEL=google/gemini-3.6-flash
AI_GATEWAY_JUDGE_MODEL=openai/gpt-5.6-sol
AGENT_REQUIRE_INDEPENDENT_JUDGE=true
AGENT_DAILY_BUDGET_CENTS=100
AGENT_LLM_TIMEOUT_MS=20000
AGENT_EMERGENCY_STOP=false

# Optional per-action emergency switches. Omit or set true to allow the existing policy.
AGENT_ACTION_OPS_SNAPSHOT_ENABLED=true
AGENT_ACTION_GROWTH_AUDIT_ENABLED=true
AGENT_ACTION_SEO_AUDIT_ENABLED=true
AGENT_ACTION_REVENUE_RECONCILE_ENABLED=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
CRON_SECRET=
OPS_ACCESS_KEY=
# Optional HTTPS webhook for warning/critical Daily Control alerts.
OPS_ALERT_WEBHOOK_URL=

# Neon/Vercel: DATABASE_URL should be pooled for runtime.
# Migrations prefer DATABASE_URL_UNPOOLED (or DIRECT_URL) when the integration exposes it.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DIRECT_URL=

CONVERSION_INGEST_SECRET=
# First attribution must occur within this many days of the referral click; lifecycle updates remain allowed.
ATTRIBUTION_WINDOW_DAYS=90

BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_API_BASE=https://demandapi-sandbox.booking.com/3.2
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_API_BASE=https://api-sandbox.ratehawk.com
HBX_API_KEY=
HBX_SECRET=
HBX_API_BASE=https://api.test.hotelbeds.com

# auto = index only when evidence gates pass; false = force NOINDEX.
SEO_LIVE_INDEXING=auto

RATEHAWK_BOOKING_ENABLED=false
HBX_BOOKING_ENABLED=false
HBX_MTLS_READY=false
HBX_PRICING_MODE=commissionable
HBX_MARKUP_PERCENT=

BOOKING_OFFER_TTL_SECONDS=900
RATEHAWK_OFFER_TTL_SECONDS=300
HBX_OFFER_TTL_SECONDS=300
BOOKING_ORDER_INITIAL_LOOKBACK_HOURS=24
AGENT_RUNTIME_ENABLED=true
SUPPLY_RUNTIME_ENABLED=true
REFERRAL_RUNTIME_ENABLED=true
DATA_RETENTION_DAYS=90
HOTEL_LEAD_RETENTION_DAYS=365
CONSUMER_MEMORY_RETENTION_DAYS=365
SOURCING_CONTACT_RETENTION_DAYS=180

# Optional transactional email for sourcing receipts + matched-rate notifications.
# Without these, sourcing cases remain in the authorized operations queue.
RESEND_API_KEY=
ATLAS_EMAIL_FROM=

LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_COUNTRY=

ADJACENCY_RUNTIME_ENABLED=false

ADJ_FLIGHT_NAME=
ADJ_FLIGHT_KEY=
ADJ_FLIGHT_URL=
ADJ_FLIGHT_TRACKING_PARAM=

ADJ_INSURANCE_NAME=
ADJ_INSURANCE_KEY=
ADJ_INSURANCE_URL=
ADJ_INSURANCE_TRACKING_PARAM=

ADJ_TELEMEDICINE_NAME=
ADJ_TELEMEDICINE_KEY=
ADJ_TELEMEDICINE_URL=
ADJ_TELEMEDICINE_TRACKING_PARAM=

ADJ_TRANSFER_NAME=
ADJ_TRANSFER_KEY=
ADJ_TRANSFER_URL=
ADJ_TRANSFER_TRACKING_PARAM=

ADJ_HOME_MANAGEMENT_NAME=
ADJ_HOME_MANAGEMENT_KEY=
ADJ_HOME_MANAGEMENT_URL=
ADJ_HOME_MANAGEMENT_TRACKING_PARAM=

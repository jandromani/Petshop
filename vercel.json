{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/supply",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/control",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rate-alerts",
      "schedule": "15 6 * * *"
    }
  ],
  "functions": {
    "app/api/queues/commerce-audit/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "atlas-events",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "regions": [
    "fra1"
  ]
}
